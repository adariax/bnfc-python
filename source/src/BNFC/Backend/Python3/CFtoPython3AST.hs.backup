{-# LANGUAGE LambdaCase #-}
{-# LANGUAGE OverloadedStrings #-}
{-# LANGUAGE TupleSections #-}

module BNFC.Backend.Python3.CFtoPython3AST (cf2Python3AST) where

import Data.Maybe      ( mapMaybe )
import BNFC.CF
import BNFC.Utils       ( (+++) )
import BNFC.Backend.Common.NamedVariables ( UserDef )
import BNFC.Backend.Python3.Common 
import Data.List (nub, intercalate)

cf2Python3AST :: String -> CF -> String
cf2Python3AST langName cf = 
  let userTokens = [ n | (n,_) <- tokenPragmas cf ]
      rules = getAbstractSyntax cf
      rulesByCategory = rules
      
      -- Generate imports
      imports = ["from __future__ import annotations"
                ,"from dataclasses import dataclass"
                ,""]
      
      -- Generate token type aliases
      tokens = map generateToken userTokens
      
      -- Generate dataclasses (without inheritance)
      classes = concatMap (generateClasses langName) rulesByCategory
      
      -- Generate union types
      unions = generateUnions langName rulesByCategory
      
      -- Handle separator-only grammars by creating basic type aliases
      separatorTypes = generateSeparatorTypes langName cf
      
      -- Generate basic type aliases for built-in types that are used
      builtinAliases = generateBuiltinAliases langName cf
      
  in unlines $ imports ++ tokens ++ classes ++ unions ++ separatorTypes ++ builtinAliases

generateToken :: UserDef -> String
generateToken token = token +++ "= str  # type alias"

generateClasses :: String -> Data -> [String]
generateClasses langName (cat, rules) = 
  mapMaybe (generateClass langName) rules

generateClass :: String -> (String, [Cat]) -> Maybe String
generateClass langName (fun, cats)
  | isNilFun fun || isOneFun fun || isConsFun fun = Nothing
  | otherwise = Just result
  where
    className = str2Python3ClassName langName fun
    vars = getVars langName cats
    fields = map (generateField langName) vars
    
    result = unlines $
      [ ""
      , "@dataclass" 
      , "class" +++ className ++ ":" ++
        if null fields then " ..." else ""
      ] ++ 
      (if null fields then [] else map ("    " ++) fields)

generateField :: String -> Python3Var -> String  
generateField langName ((listDepth, typeName), (varName, idx)) = 
  let fieldName = if idx > 0 
                 then toSnakeCase varName ++ show idx
                 else toSnakeCase varName
      
      baseType = case name2Python3BuiltIn typeName of
                  Just builtinType -> builtinType
                  Nothing -> str2Python3ClassName langName typeName
      
      finalType = addListWrappers listDepth baseType
      
  in fieldName ++ ": " ++ finalType
  where
    addListWrappers 0 t = t
    addListWrappers n t = "list[" ++ addListWrappers (n-1) t ++ "]"

generateUnions :: String -> [Data] -> [String]
generateUnions langName rulesByCategory = 
  let categoryNames = nub $ map (getCategoryName langName . fst) rulesByCategory
  in concatMap (generateUnion langName rulesByCategory) categoryNames

getCategoryName :: String -> Cat -> String
getCategoryName langName cat = str2Python3ClassName langName (catToStr (normCat cat))

generateUnion :: String -> [Data] -> String -> [String]
generateUnion langName allRules categoryName = 
  let constructors = getConstructorsForCategory langName allRules categoryName
  in if null constructors
     then []
     else [""
          , categoryName +++ "=" +++ intercalate " | " constructors
          , ""]

getConstructorsForCategory :: String -> [Data] -> String -> [String]
getConstructorsForCategory langName allRules targetCategory = 
  let matchingRules = filter (\(cat, _) -> getCategoryName langName cat == targetCategory) allRules
  in concatMap getConstructorNames matchingRules
  where
    getConstructorNames (_, rules) = 
      mapMaybe (\(fun, _) -> 
        if isNilFun fun || isOneFun fun || isConsFun fun
        then Nothing
        else Just (str2Python3ClassName langName fun)
      ) rules

generateSeparatorTypes :: String -> CF -> [String]
generateSeparatorTypes langName cf = 
  let allCats = allParserCats cf
      rules = getAbstractSyntax cf
      -- Find categories that have no explicit constructors (separator-only)
      categoriesWithRules = map fst rules
      separatorOnlyCats = filter (\cat -> cat `notElem` categoriesWithRules) allCats
      -- Also check for built-in types that need aliases
      builtinCats = filter isBuiltinCat allCats
      allMissingCats = nub (separatorOnlyCats ++ builtinCats)
      -- Create type aliases for built-in types
      typeAliases = mapMaybe (createTypeAlias langName) allMissingCats
  in if null typeAliases then [] else "" : typeAliases
  where
    isBuiltinCat cat = case catToStr (normCat cat) of
      "Integer" -> True
      "Double" -> True
      "String" -> True
      "Char" -> True
      "Ident" -> True
      _ -> False
    
    createTypeAlias langName cat = 
      let catName = str2Python3ClassName langName (catToStr (normCat cat))
          baseType = case name2Python3BuiltIn (catToStr (normCat cat)) of
                      Just builtinType -> builtinType
                      Nothing -> "str"  -- Default fallback
      in if catName /= baseType && not (checkRegistered catName)
         then Just (catName +++ "=" +++ baseType +++ " # type alias")
         else Nothing

generateBuiltinAliases :: String -> CF -> [String]
generateBuiltinAliases langName cf = 
  let -- Check if we have any explicit dataclass rules
      rules = getAbstractSyntax cf
      hasDataClasses = any hasNonListRules rules
      -- If we have no dataclasses, generate basic type aliases
      basicTypes = if hasDataClasses then [] else ["Integer", "Double", "String", "Char", "Ident"]
      aliases = mapMaybe (createBuiltinAlias langName) basicTypes
  in if null aliases then [] else "" : aliases
  where
    hasNonListRules (_, ruleList) = any (\(fun, _) -> not (isNilFun fun || isOneFun fun || isConsFun fun)) ruleList
    
    createBuiltinAlias langName typeName = 
      let className = str2Python3ClassName langName typeName
          baseType = case name2Python3BuiltIn typeName of
                      Just builtinType -> builtinType
                      Nothing -> "str"
      in if className /= baseType && not (checkRegistered className)
         then Just (className +++ "=" +++ baseType +++ " # type alias")
         else Nothing
